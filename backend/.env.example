OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Prototype-only: no scheduling/EHR system exists yet, so identity verification
# checks against a single synthetic demo patient.
DEMO_PATIENT_DOB=1990-05-14
DEMO_PATIENT_PHONE=5551234567

# --- Cascaded voice pipeline benchmark (docs/voice-pipeline-benchmark-plan.md) ---
# Each hop is selected independently, because the cost is not spread evenly across them.
#   VOICE_STT / VOICE_LLM / VOICE_TTS = openai | groq | local
# VOICE_PROFILE sets all three at once as a shorthand.
VOICE_PROFILE=openai
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Groq — OpenAI-compatible on all three hops. Transcription is batch-only.
# Both Llama models are deprecated 2026-08-16. gpt-oss-20b is the fastest replacement but
# fabricates verify_identity arguments, so gpt-oss-120b is the default; qwen3.6-27b reasons
# before tool calls and doubles the worst case. See the benchmark plan doc.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

# Local — nothing leaves the machine, so there is no processor to cover by a BAA.
# Prefer the resident servers over the CLI paths: spawning a binary per turn reloads the
# model every time, which swamps what is being measured.
#   whisper-server -m ~/.cache/whisper-models/ggml-base.en.bin --host 127.0.0.1 --port 8178
LOCAL_STT_URL=
LOCAL_STT_WEIGHTS=
#   ~/.cache/kokoro-venv/bin/python backend/tools/kokoro_server.py --port 8179
LOCAL_TTS_URL=
LOCAL_LLM_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Refuses to start if any selected provider is not BAA-covered.
PHI_MODE=false

# Benchmark knobs
BENCH_ITERATIONS=5
BENCH_HANGOVER_VERIFICATION=350
BENCH_HANGOVER_INTAKE=700
BENCH_TARGET_MS=1000
